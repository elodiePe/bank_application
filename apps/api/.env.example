# Server (named API_PORT, not PORT, so it can never collide with an ambient
# PORT env var some tools/hosts inject for "the" web process)
API_PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (CORS). In production this must be the exact
# GitHub Pages origin (e.g. https://username.github.io), not a wildcard, and NEVER include
# a path or trailing slash — CORS origin matching is exact-string on scheme+host+port only.
WEB_ORIGIN=http://localhost:5173

# Where the web app is actually served, including any sub-path — used to build the links
# inside emails (verify-email, reset-password, delete-family). GitHub Pages project sites
# live under /<repo-name>/, not the domain root, so this must include that sub-path in
# production (e.g. https://username.github.io/bank_application). Leave unset to fall back
# to WEB_ORIGIN, which is correct for local dev (served from the domain root).
WEB_APP_URL=

# PostgreSQL (Supabase). DATABASE_URL is the pooled connection (port 6543, used at
# runtime); DIRECT_URL is the session connection (port 5432, used for migrations).
# Both come from Supabase → Project Settings → Database → Connect → ORMs → Prisma.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Auth secrets (set to long random values in real environments)
JWT_ACCESS_SECRET=changeme-access
JWT_REFRESH_SECRET=changeme-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Set to true once served over HTTPS in production. Also switches cookies to
# SameSite=None (required since the frontend and API are on different domains),
# which itself requires Secure — so this one flag drives both.
COOKIE_SECURE=false

# Web Push (VAPID) — generate your own with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Family owner login (creates/logs into a family) — only used in plaintext by the seed
# script (to compute the bcrypt hash stored in Family.ownerPasswordHash); never read
# at runtime.
FAMILY_OWNER_EMAIL=change-me@example.com
FAMILY_OWNER_PASSWORD=change-me-too
FAMILY_OWNER_SECRET=change-me-as-well
FAMILY_OWNER_TTL_SECONDS=2592000

# Signs the short-lived tokens embedded in transactional email links
# (verify-email, confirm-account-deletion)
EMAIL_ACTION_SECRET=change-me-email-action

# Transactional email via Resend (https://resend.com) — HTTP API, not SMTP. Render (and many
# other PaaS hosts) blocks outbound SMTP ports, so raw SMTP does not work once deployed there.
# Leave RESEND_API_KEY empty in dev: emails are logged to the server console instead of being sent.
# EMAIL_FROM's domain must be verified in the Resend dashboard (Domains) before it can send to
# arbitrary recipients — resend.dev sender addresses only deliver to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="FamilyApp <no-reply@example.com>"
# Where messages from the public /contact page are sent.
CONTACT_EMAIL="informations@unmatched.ch"

# Stock market data (Finnhub — https://finnhub.io), free tier.
FINNHUB_API_KEY=

# Billing (Stripe — https://dashboard.stripe.com/test/apikeys). Start in test mode: keys
# prefixed sk_test_/whsec_test_ never touch real money. Leave all four empty in dev — every
# other feature works without them; only /billing/* routes need them.
# STRIPE_SECRET_KEY: Developers → API keys → Secret key. NEVER the publishable key, and NEVER
# commit a real value — this grants full account access.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: Developers → Webhooks → your endpoint → Signing secret. Required to
# verify that a /billing/webhook request actually came from Stripe, not an attacker forging a
# "subscription active" event.
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_FAMILLE / STRIPE_PRICE_GRANDE_FAMILLE: Product catalog → each plan's recurring
# Price ID (price_...), NOT the Product ID (prod_...). Create one yearly recurring price per
# plan (12 CHF/an and 24 CHF/an) matching packages/shared/src/subscription.ts.
STRIPE_PRICE_FAMILLE=
STRIPE_PRICE_GRANDE_FAMILLE=
