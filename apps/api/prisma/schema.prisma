// Schéma de données de la Banque Familiale.
// Tous les montants sont stockés en centimes (Int) pour éviter les erreurs d'arrondi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  CHILD
}

/// Which child dashboard variant to render — chosen directly by a parent (not derived
/// from a birth date), since a parent knows their own child's maturity better than an
/// age calculation would. Ignored for PARENT users.
enum ChildInterfaceLevel {
  YOUNG
  MIDDLE
  TEEN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  TRANSFER
  REQUEST
  VALIDATION
  REFUSAL
  CORRECTION
  STOCK_BUY
  STOCK_SELL
  STOCK_GIFT
  CHORE_REWARD
}

enum ChoreRecurrence {
  ONCE
  DAILY
  WEEKLY
}

enum ChoreCompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether a chore's reward moves real money (a Transaction, like today) or just adds to
/// a purely cosmetic points score kept on ChildAccount — chosen per chore by the parent.
enum ChoreRewardType {
  MONEY
  POINTS
}

enum StockOrderType {
  BUY
  SELL
}

enum StockOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  REVERSED
}

enum MoneyRequestType {
  DEPOSIT_REQUEST
  WITHDRAWAL_REQUEST
  TRANSFER_REQUEST
}

enum MoneyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DisputeStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum NotificationType {
  MONEY_REQUEST_CREATED
  MONEY_REQUEST_APPROVED
  MONEY_REQUEST_REJECTED
  TRANSFER_RECEIVED
  DEPOSIT_RECEIVED
  WITHDRAWAL_PROCESSED
  INTEREST_APPLIED
  CORRECTION_APPLIED
  STOCK_ORDER_CREATED
  STOCK_ORDER_APPROVED
  STOCK_ORDER_REJECTED
  STOCK_GIFT_RECEIVED
  CREDENTIAL_RESET_REQUESTED
  DISPUTE_RAISED
  DISPUTE_DISMISSED
  CHORE_COMPLETED
  CHORE_APPROVED
  CHORE_REJECTED
  CHORE_REMINDER
  MEAL_PLAN_TURN
  GENERIC
}

enum MealPlanDayMode {
  FIXED
  ROTATING
}

/// A family is its own isolated tenant: its own owner login, members, accounts and
/// history. Nothing is ever shared or visible across families.
model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The account used to create/log into this family (distinct from the individual
  /// PARENT/CHILD member profiles reached afterwards via the "who's logging in?" picker).
  ownerEmail               String    @unique
  ownerEmailVerifiedAt     DateTime?
  ownerPasswordHash        String
  ownerFailedLoginAttempts Int       @default(0)
  ownerLockedUntil         DateTime?

  /// Set once the first parent finishes the guided setup wizard (add first child,
  /// allowance, interest rate, push notifications). Null = wizard still pending.
  onboardingCompletedAt DateTime?

  users    User[]
  settings Settings?
}

model User {
  id             String              @id @default(cuid())
  familyId       String
  family         Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role           Role
  firstName      String
  /// Parents only — used as a confirmation step when deactivating a family member, and
  /// for future account recovery. Not required for children.
  email          String?             @unique
  /// Parents only — bcrypt hash.
  passwordHash   String?
  /// Required for children, optional for parents — bcrypt hash of a 4-digit PIN.
  pinHash        String?
  /// Children only — which dashboard variant to show them, set by a parent. Defaults to
  /// MIDDLE (today's unchanged dashboard) so existing accounts render exactly as before.
  interfaceLevel ChildInterfaceLevel @default(MIDDLE)

  /// Brute-force protection — a 4-digit PIN only has 10 000 combinations.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Parents only. The single fixed admin (the first parent created for the family) can
  /// manage the other parents' permissions below and always has full access regardless of
  /// those booleans. Not applicable to children.
  isAdmin           Boolean @default(false)
  canManageMoney    Boolean @default(true)
  canManageActions  Boolean @default(true)
  canManageSettings Boolean @default(true)
  canManageFamily   Boolean @default(true)

  /// Soft delete: a deactivated member can no longer log in and is hidden from the login
  /// picker and "add member" flows, but their transaction history is never deleted —
  /// consistent with the ledger being immutable everywhere else in this app.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childAccount ChildAccount?

  notificationsReceived     Notification[]     @relation("NotificationRecipient")
  moneyRequestsMade         MoneyRequest[]     @relation("MoneyRequestRequester")
  moneyRequestsTargeted     MoneyRequest[]     @relation("MoneyRequestTarget")
  moneyRequestsResponded    MoneyRequest[]     @relation("MoneyRequestResponder")
  disputesRaised            Dispute[]          @relation("DisputeRaisedBy")
  disputesResolved          Dispute[]          @relation("DisputeResolvedBy")
  transactionsSent          Transaction[]      @relation("TransactionSender")
  transactionsReceived      Transaction[]      @relation("TransactionReceiver")
  transactionsValidated     Transaction[]      @relation("TransactionValidator")
  auditLogs                 AuditLog[]         @relation("AuditLogActor")
  refreshSessions           RefreshSession[]
  pushSubscriptions         PushSubscription[] @relation("PushSubscriptionOwner")
  stockOrdersMade           StockOrder[]       @relation("StockOrderRequester")
  stockOrdersResponded      StockOrder[]       @relation("StockOrderResponder")
  choresAssigned            Chore[]            @relation("ChoreChild")
  choreCompletionsResponded ChoreCompletion[]  @relation("ChoreCompletionResponder")
  mealPlanFixedDays         MealPlanSlot[]             @relation("MealPlanFixedAssignee")
  mealCookNotifications     MealCookNotificationLog[]  @relation("MealCookNotified")
  shoppingListItemsAdded    ShoppingListItem[]         @relation("ShoppingListAddedBy")
  shoppingListItemsChecked  ShoppingListItem[]         @relation("ShoppingListCheckedBy")

  @@index([familyId])
  /// Covers the login-picker query (active members of a family), run on every family
  /// login screen load.
  @@index([familyId, deactivatedAt])
}

model ChildAccount {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int    @default(0)

  /// Cumulative score from chores rewarded in points instead of money. Purely cosmetic for
  /// now — no conversion to real money, no redemption.
  pointsBalance Int @default(0)

  /// Weekly pocket money, in cents. 0 = disabled for this child.
  weeklyAllowanceCents  Int       @default(0)
  /// Set when weeklyAllowanceCents transitions from 0 to a positive value; cleared when
  /// disabled again. Bounds catch-up processing so enabling this feature on an account with
  /// years of history doesn't backfill every missed week since account creation.
  allowanceEnabledSince DateTime?

  /// Set (once, lazily) the first time interestService ever processes this account. Anchors
  /// which month is the first eligible one, so accounts imported with historical CSV data
  /// don't get interest backfilled into months the source bank already accounted for.
  interestEligibleSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions     Transaction[]
  interestHistory  InterestHistory[]
  allowanceHistory AllowanceHistory[]
  stockHoldings    StockHolding[]
  stockOrders      StockOrder[]
}

model Transaction {
  id                 String            @id @default(cuid())
  accountId          String
  account            ChildAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type               TransactionType
  status             TransactionStatus @default(COMPLETED)
  amountCents        Int
  balanceBeforeCents Int
  balanceAfterCents  Int
  comment            String?

  /// Set only for STOCK_BUY/STOCK_SELL/STOCK_GIFT — lets a holding's individual lots be
  /// queried directly instead of parsed out of the free-text comment.
  stockSymbol   String?
  stockQuantity Float?

  /// Stable identifier for rows imported from an external source (e.g. a CSV history
  /// file) so re-running an import never creates duplicates.
  externalRef String? @unique

  senderId   String?
  sender     User?   @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   User?   @relation("TransactionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /// Parent who validated/performed this operation (null for automated interest).
  validatedById String?
  validatedBy   User?   @relation("TransactionValidator", fields: [validatedById], references: [id], onDelete: Cascade)

  /// Links the two legs (debit/credit) of a transfer between two child accounts.
  transferGroupId String?

  /// Self-relation: a correction is a new transaction reversing an earlier one.
  reversalOfId String?      @unique
  reversalOf   Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversedBy   Transaction? @relation("TransactionReversal")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([transferGroupId])
  @@index([occurredAt])
  /// Covers the per-account history query (a child's or family's transaction list,
  /// paginated newest-first) without a separate sort step.
  @@index([accountId, occurredAt])
  /// Covers looking up a stock holding's individual lots (buy/sell/gift rows for one
  /// symbol in one account).
  @@index([accountId, stockSymbol])
}

model MoneyRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("MoneyRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// Null when the request targets "the parents" generically rather than one sibling.
  targetUserId String?
  targetUser   User?   @relation("MoneyRequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  type   MoneyRequestType
  status MoneyRequestStatus @default(PENDING)

  amountCents Int
  comment     String?

  respondedById String?
  respondedBy   User?     @relation("MoneyRequestResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set once approved, linking to the transaction(s) it produced.
  transferGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

/// A recurring or one-off task assigned by a parent to one specific child, with a cash
/// reward. familyId is a loose (non-relation) scope field, same convention as
/// Dispute.transactionId below — the child it's assigned to already anchors it to a family.
model Chore {
  id String @id @default(cuid())

  familyId String

  childUserId String
  childUser   User   @relation("ChoreChild", fields: [childUserId], references: [id], onDelete: Cascade)

  title        String
  rewardType   ChoreRewardType @default(MONEY)
  /// Set when rewardType is MONEY, null when POINTS.
  rewardCents  Int?
  /// Set when rewardType is POINTS, null when MONEY.
  rewardPoints Int?
  recurrence   ChoreRecurrence

  /// Soft toggle, never hard-deleted — consistent with deactivatedAt elsewhere. Also set to
  /// false automatically once a ONCE chore's completion is approved (nothing left to do).
  active Boolean @default(true)

  /// Set when a CHORE_REMINDER notification was last sent to the child for this chore's
  /// current period, so the hourly reminder check never nags twice for the same period.
  lastReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions ChoreCompletion[]

  @@index([familyId])
  @@index([childUserId])
}

/// One row per time a child marks a chore done. Unlike AllowanceHistory/InterestHistory
/// (system-generated, strictly one row per period), there is no DB-level unique constraint
/// on [choreId, periodStart]: a REJECTED completion must allow the child to try again in the
/// same period, so "already pending/done for this period" is checked in application code.
model ChoreCompletion {
  id String @id @default(cuid())

  choreId String
  chore   Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)

  /// The day (DAILY), the Monday of the week (WEEKLY), or the chore's creation day (ONCE)
  /// this completion counts toward.
  periodStart DateTime
  status      ChoreCompletionStatus @default(PENDING)

  /// Copied from Chore.rewardType/rewardCents/rewardPoints at completion time, so a later
  /// reward edit never rewrites already-recorded history.
  rewardType   ChoreRewardType
  rewardCents  Int?
  rewardPoints Int?

  respondedById String?
  respondedBy   User?     @relation("ChoreCompletionResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set only once approved, linking to the transaction it produced.
  transactionId String? @unique

  /// Set once a CHORE_REMINDER notification has been sent to the parents for this pending
  /// completion, so the hourly reminder check only nags once per completion.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([choreId])
  @@index([status])
}

/// One reward tier a parent defines for a specific child's cosmetic chore-points score (e.g.
/// "100 points = choisir le dessert"). Per-child, not family-wide — each child has their own
/// ladder, since siblings rarely want the same rewards at the same point thresholds.
model PointsRewardGoal {
  id String @id @default(cuid())

  familyId       String
  childUserId    String
  title          String
  pointsRequired Int

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([childUserId])
}

/// One config row per weekday (0 = Monday .. 6 = Sunday) saying who cooks dinner that day.
/// FIXED always resolves to `fixedUserId`. ROTATING draws from the family's single shared
/// rotation order (MealPlanRotationOrder below) — every rotating weekday uses the same list
/// and sequence, just offset by its own weekday number so several rotating days in the same
/// week don't all land on the same person. Advances automatically every week — no stored
/// per-week state, no scheduled job needed to "move it along".
model MealPlanSlot {
  id String @id @default(cuid())

  familyId String
  weekday  Int

  mode MealPlanDayMode @default(FIXED)

  /// Set when mode is FIXED, null when ROTATING.
  fixedUserId String?
  fixedUser   User?   @relation("MealPlanFixedAssignee", fields: [fixedUserId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([familyId, weekday])
  @@index([familyId])
}

/// The one shared rotation order used by every ROTATING weekday in a family — one row per
/// family. Deliberately not per-weekday: "the rotation order is always the same" regardless
/// of which day is rotating, so the parent only ever configures it once.
model MealPlanRotationOrder {
  familyId        String   @id
  orderedUserIds  String[] @default([])
  updatedAt       DateTime @updatedAt
}

/// Dedupe log for the "it's your turn to cook" pushes — one row per family, per calendar date,
/// per kind (TODAY same-day reminder, ADVANCE the evening-before heads-up for the next day) once
/// that (date, kind) pair has been notified, so the hourly check never nags twice. Split by kind
/// because both reminders can legitimately target the same date: TODAY's advance notice sent
/// yesterday evening, and TODAY's own same-day reminder sent once that date arrives.
model MealCookNotificationLog {
  id String @id @default(cuid())

  familyId String
  date     DateTime
  kind     String   @default("TODAY")

  userId String
  user   User   @relation("MealCookNotified", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([familyId, date, kind])
  @@index([familyId])
}

/// A shared family shopping list — any member can add or check off an item. familyId is a
/// loose scope field, same convention as Chore.familyId above.
model ShoppingListItem {
  id String @id @default(cuid())

  familyId String
  label    String

  isChecked Boolean @default(false)

  addedById String
  addedBy   User   @relation("ShoppingListAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  checkedById String?
  checkedBy   User?   @relation("ShoppingListCheckedBy", fields: [checkedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([familyId])
}

/// A child flagging one of their own completed transactions as erroneous. Loosely linked to
/// the Transaction by id (same pattern as Notification's relatedTransactionId) rather than a
/// hard relation, since a transaction can outlive/precede the dispute feature.
model Dispute {
  id String @id @default(cuid())

  transactionId String

  raisedById String
  raisedBy   User   @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  reason String
  status DisputeStatus @default(PENDING)

  resolvedById String?
  resolvedBy   User?     @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([raisedById])
  @@index([status])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title  String
  body   String
  isRead Boolean @default(false)

  relatedTransactionId     String?
  relatedMoneyRequestId    String?
  relatedDisputeId         String?
  relatedChoreCompletionId String?
  /// Set only for CHORE_REMINDER (fires before any completion exists, unlike the field above).
  relatedChoreId           String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

/// One row per browser/device the user enabled push notifications on (endpoint is
/// unique per subscription, so the same user can have several devices).
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("PushSubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model InterestHistory {
  id            String       @id @default(cuid())
  accountId     String
  account       ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Normalized to the 1st day of the month the interest was earned for.
  month         DateTime
  rateBps       Int
  amountCents   Int
  transactionId String       @unique
  createdAt     DateTime     @default(now())

  @@unique([accountId, month])
}

/// Records each weekly allowance payment so processing is idempotent (never pay the same
/// week twice) even if the server was offline and catches up on several weeks at once.
model AllowanceHistory {
  id            String       @id @default(cuid())
  accountId     String
  account       ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Normalized to the Monday of the week this allowance was paid for.
  weekStart     DateTime
  amountCents   Int
  transactionId String       @unique
  createdAt     DateTime     @default(now())

  @@unique([accountId, weekStart])
}

/// A child's current position in one stock symbol. Quantity/average cost are kept as a
/// running aggregate rather than derived from StockOrder history each time, so reading a
/// portfolio never needs to replay every past order.
model StockHolding {
  id               String       @id @default(cuid())
  accountId        String
  account          ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol           String
  companyName      String
  quantity         Float
  /// Average cost per share, in cents — recomputed on every BUY/GIFT; unchanged on SELL.
  averageCostCents Int
  /// Set once when the position is opened (first BUY or GIFT); unchanged by later top-ups.
  /// A position that's fully sold and later reopened gets a fresh date on the new row.
  firstPurchaseAt  DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, symbol])
}

/// A child-proposed buy/sell order awaiting parental approval — mirrors MoneyRequest's
/// propose/approve/reject/cancel lifecycle, but for stock trades instead of cash moves.
model StockOrder {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("StockOrderRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  accountId String
  account   ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type   StockOrderType
  status StockOrderStatus @default(PENDING)

  symbol              String
  companyName         String
  quantity            Float
  /// Price snapshot at request time, shown to the parent for context — the actual trade
  /// re-fetches a live quote at approval time rather than trusting this stale value.
  estimatedPriceCents Int
  comment             String?

  respondedById String?
  respondedBy   User?     @relation("StockOrderResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set once approved, linking to the transaction it produced.
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([accountId])
  @@index([status])
}

model Settings {
  id       String @id @default(cuid())
  familyId String @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  /// Interest rate in basis points (240 = 2.40%).
  defaultInterestRateBps Int    @default(240)
  currency               String @default("CHF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

/// Persisted so refresh tokens can be revoked (logout, rotation, security incident)
/// instead of relying purely on stateless JWT expiry.
model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the refresh token — the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
