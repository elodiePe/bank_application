// Schéma de données de la FamilyApp.
// Tous les montants sont stockés en centimes (Int) pour éviter les erreurs d'arrondi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  CHILD
}

/// Mirrors the three plans shown on the pricing page (packages/shared/src/subscription.ts is
/// the single source of truth for what each tier actually unlocks — child limit, sections).
enum SubscriptionTier {
  ESSENTIEL
  FAMILLE
  GRANDE_FAMILLE
}

/// Which child dashboard variant to render — chosen directly by a parent (not derived
/// from a birth date), since a parent knows their own child's maturity better than an
/// age calculation would. Ignored for PARENT users.
enum ChildInterfaceLevel {
  YOUNG
  MIDDLE
  TEEN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  TRANSFER
  REQUEST
  VALIDATION
  REFUSAL
  CORRECTION
  STOCK_BUY
  STOCK_SELL
  STOCK_GIFT
  CHORE_REWARD
}

enum ChoreRecurrence {
  ONCE
  DAILY
  WEEKLY
}

enum ChoreCompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether a chore's reward moves real money (a Transaction, like today) or just adds to
/// a purely cosmetic points score kept on ChildAccount — chosen per chore by the parent.
enum ChoreRewardType {
  MONEY
  POINTS
  NONE
}

enum StockOrderType {
  BUY
  SELL
}

enum StockOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  REVERSED
}

enum MoneyRequestType {
  DEPOSIT_REQUEST
  WITHDRAWAL_REQUEST
  TRANSFER_REQUEST
}

enum MoneyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DisputeStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum NotificationType {
  MONEY_REQUEST_CREATED
  MONEY_REQUEST_APPROVED
  MONEY_REQUEST_REJECTED
  TRANSFER_RECEIVED
  DEPOSIT_RECEIVED
  WITHDRAWAL_PROCESSED
  INTEREST_APPLIED
  CORRECTION_APPLIED
  STOCK_ORDER_CREATED
  STOCK_ORDER_APPROVED
  STOCK_ORDER_REJECTED
  STOCK_GIFT_RECEIVED
  CREDENTIAL_RESET_REQUESTED
  DISPUTE_RAISED
  DISPUTE_DISMISSED
  CHORE_COMPLETED
  CHORE_APPROVED
  CHORE_REJECTED
  CHORE_REMINDER
  MEAL_PLAN_TURN
  LAUNDRY_TURN
  SHOPPING_TRIP
  GENERIC
  PAYMENT_PAST_DUE
}

/// Coarse grouping of NotificationType, used only for the per-user on/off preference below —
/// one toggle per family-visible section rather than one per exact event. CREDENTIAL_RESET_
/// REQUESTED deliberately has no category (see notification.ts categoryForNotificationType) so
/// it can never be muted — a parent must always hear about a child's PIN reset request.
enum NotificationCategory {
  MONEY_REQUESTS
  STOCKS
  DISPUTES
  CHORES
  MEALS
  LAUNDRY
  SHOPPING
  CUSTOM
}

enum MealPlanDayMode {
  FIXED
  ROTATING
}

/// When a LaundryType is due — see LaundryType.scheduleType for the meaning of each value.
enum LaundryScheduleType {
  ONCE
  WEEKLY
  MULTIPLE
}

/// A family is its own isolated tenant: its own owner login, members, accounts and
/// history. Nothing is ever shared or visible across families.
model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The account used to create/log into this family (distinct from the individual
  /// PARENT/CHILD member profiles reached afterwards via the "who's logging in?" picker).
  ownerEmail               String    @unique
  ownerEmailVerifiedAt     DateTime?
  ownerPasswordHash        String
  ownerFailedLoginAttempts Int       @default(0)
  ownerLockedUntil         DateTime?

  /// Set at registration, when the CGU/politique de confidentialité checkbox is accepted —
  /// demonstrable proof of consent (GDPR Art. 7(1)/nLPD). Null for families that registered
  /// before this existed.
  termsAcceptedAt DateTime?

  /// Set once the first parent finishes the guided setup wizard (add first child,
  /// allowance, interest rate, push notifications). Null = wizard still pending.
  onboardingCompletedAt DateTime?

  /// Billing — synced exclusively from verified Stripe webhook events (never from the client
  /// redirect after checkout, which can't be trusted). ESSENTIEL is the default free tier, so
  /// a family that never subscribes never touches Stripe at all.
  subscriptionTier         SubscriptionTier @default(ESSENTIEL)
  /// Created lazily on first checkout attempt — null until then.
  stripeCustomerId         String?          @unique
  stripeSubscriptionId     String?          @unique
  /// Stripe's own status string (active, past_due, canceled, unpaid, ...) — kept verbatim
  /// rather than re-modeled, so new Stripe statuses don't require a migration to display.
  stripeSubscriptionStatus String?
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?

  /// Set the moment a subscription that WAS paid (subscriptionTier was FAMILLE/GRANDE_FAMILLE)
  /// drops out of active/trialing status — starts the 30-day grace period before the family and
  /// its entire history are deleted. Null while never in this state, or once payment recovers.
  paymentGracePeriodStartedAt DateTime?
  /// Set once the J-7 reminder has actually been sent, so the daily check never sends it twice.
  paymentGraceReminderSentAt DateTime?

  /// Pending email-MFA challenge for the owner login, set once the password has already been
  /// verified. The code itself is never stored in plaintext. Cleared on success, on expiry, or
  /// once ownerMfaCodeAttempts hits the cap — any of those forces a fresh login from scratch.
  ownerMfaCodeHash      String?
  ownerMfaCodeExpiresAt DateTime?
  ownerMfaCodeAttempts  Int       @default(0)

  users    User[]
  settings Settings?
}

model User {
  id             String              @id @default(cuid())
  familyId       String
  family         Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role           Role
  firstName      String
  /// Parents only — used as a confirmation step when deactivating a family member, and
  /// for future account recovery. Not required for children.
  email          String?             @unique
  /// Parents only — bcrypt hash.
  passwordHash   String?
  /// Required for children, optional for parents — bcrypt hash of a 4-digit PIN.
  pinHash        String?
  /// Children only — which dashboard variant to show them, set by a parent. Defaults to
  /// MIDDLE (today's unchanged dashboard) so existing accounts render exactly as before.
  interfaceLevel ChildInterfaceLevel @default(MIDDLE)
  /// Children only — self-service preference (TEEN can toggle it in Paramètres; MIDDLE/YOUNG
  /// keep the default) for whether their own points count is shown on their dashboard.
  showPointsBalance Boolean @default(true)

  /// Brute-force protection — a 4-digit PIN only has 10 000 combinations.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Parents only. The single fixed admin (the first parent created for the family) can
  /// manage the other parents' permissions below and always has full access regardless of
  /// those booleans. Not applicable to children.
  isAdmin           Boolean @default(false)
  canManageMoney    Boolean @default(true)
  canManageActions  Boolean @default(true)
  canManageSettings Boolean @default(true)
  canManageFamily   Boolean @default(true)

  /// Soft delete: a deactivated member can no longer log in and is hidden from the login
  /// picker and "add member" flows, but their transaction history is never deleted —
  /// consistent with the ledger being immutable everywhere else in this app.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childAccount ChildAccount?

  notificationsReceived     Notification[]     @relation("NotificationRecipient")
  moneyRequestsMade         MoneyRequest[]     @relation("MoneyRequestRequester")
  moneyRequestsTargeted     MoneyRequest[]     @relation("MoneyRequestTarget")
  moneyRequestsResponded    MoneyRequest[]     @relation("MoneyRequestResponder")
  disputesRaised            Dispute[]          @relation("DisputeRaisedBy")
  disputesResolved          Dispute[]          @relation("DisputeResolvedBy")
  transactionsSent          Transaction[]      @relation("TransactionSender")
  transactionsReceived      Transaction[]      @relation("TransactionReceiver")
  transactionsValidated     Transaction[]      @relation("TransactionValidator")
  auditLogs                 AuditLog[]         @relation("AuditLogActor")
  refreshSessions           RefreshSession[]
  pushSubscriptions         PushSubscription[] @relation("PushSubscriptionOwner")
  stockOrdersMade           StockOrder[]       @relation("StockOrderRequester")
  stockOrdersResponded      StockOrder[]       @relation("StockOrderResponder")
  choresAssigned            Chore[]            @relation("ChoreChild")
  choreCompletionsResponded ChoreCompletion[]  @relation("ChoreCompletionResponder")
  mealCookNotifications     MealCookNotificationLog[]  @relation("MealCookNotified")
  shoppingListItemsAdded    ShoppingListItem[]         @relation("ShoppingListAddedBy")
  shoppingListItemsChecked  ShoppingListItem[]         @relation("ShoppingListCheckedBy")
  laundryNotifications      LaundryNotificationLog[]   @relation("LaundryNotified")
  customNotificationsMade   CustomNotification[]       @relation("CustomNotificationCreatedBy")
  personalTasks             PersonalTask[]             @relation("PersonalTaskOwner")
  savingsGoal               SavingsGoal?               @relation("SavingsGoalOwner")
  notificationPreferences   NotificationPreference[]

  @@index([familyId])
  /// Covers the login-picker query (active members of a family), run on every family
  /// login screen load.
  @@index([familyId, deactivatedAt])
}

model ChildAccount {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int    @default(0)

  /// Cumulative score from chores rewarded in points instead of money. Purely cosmetic for
  /// now — no conversion to real money, no redemption.
  pointsBalance Int @default(0)

  /// Weekly pocket money, in cents. 0 = disabled for this child.
  weeklyAllowanceCents  Int       @default(0)
  /// Set when weeklyAllowanceCents transitions from 0 to a positive value; cleared when
  /// disabled again. Bounds catch-up processing so enabling this feature on an account with
  /// years of history doesn't backfill every missed week since account creation.
  allowanceEnabledSince DateTime?

  /// Set (once, lazily) the first time interestService ever processes this account. Anchors
  /// which month is the first eligible one, so accounts imported with historical CSV data
  /// don't get interest backfilled into months the source bank already accounted for.
  interestEligibleSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions     Transaction[]
  interestHistory  InterestHistory[]
  allowanceHistory AllowanceHistory[]
  stockHoldings    StockHolding[]
  stockOrders      StockOrder[]
}

model Transaction {
  id                 String            @id @default(cuid())
  accountId          String
  account            ChildAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type               TransactionType
  status             TransactionStatus @default(COMPLETED)
  amountCents        Int
  balanceBeforeCents Int
  balanceAfterCents  Int
  comment            String?

  /// Set only for STOCK_BUY/STOCK_SELL/STOCK_GIFT — lets a holding's individual lots be
  /// queried directly instead of parsed out of the free-text comment.
  stockSymbol   String?
  stockQuantity Float?

  /// Stable identifier for rows imported from an external source (e.g. a CSV history
  /// file) so re-running an import never creates duplicates.
  externalRef String? @unique

  senderId   String?
  sender     User?   @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   User?   @relation("TransactionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /// Parent who validated/performed this operation (null for automated interest).
  validatedById String?
  validatedBy   User?   @relation("TransactionValidator", fields: [validatedById], references: [id], onDelete: Cascade)

  /// Links the two legs (debit/credit) of a transfer between two child accounts.
  transferGroupId String?

  /// Self-relation: a correction is a new transaction reversing an earlier one.
  reversalOfId String?      @unique
  reversalOf   Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversedBy   Transaction? @relation("TransactionReversal")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([transferGroupId])
  @@index([occurredAt])
  /// Covers the per-account history query (a child's or family's transaction list,
  /// paginated newest-first) without a separate sort step.
  @@index([accountId, occurredAt])
  /// Covers looking up a stock holding's individual lots (buy/sell/gift rows for one
  /// symbol in one account).
  @@index([accountId, stockSymbol])
}

model MoneyRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("MoneyRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// Null when the request targets "the parents" generically rather than one sibling.
  targetUserId String?
  targetUser   User?   @relation("MoneyRequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  type   MoneyRequestType
  status MoneyRequestStatus @default(PENDING)

  amountCents Int
  comment     String?
  /// Optional receipt photo attached by a MIDDLE/TEEN child when requesting money — resized
  /// client-side to a JPEG data URL, same inline-storage pattern as SavingsGoal.photoDataUrl
  /// (no file-storage service in this app).
  receiptPhotoDataUrl String? @db.Text

  respondedById String?
  respondedBy   User?     @relation("MoneyRequestResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set once approved, linking to the transaction(s) it produced.
  transferGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

/// A recurring or one-off task assigned by a parent to one specific child, with a cash
/// reward. familyId is a loose (non-relation) scope field, same convention as
/// Dispute.transactionId below — the child it's assigned to already anchors it to a family.
model Chore {
  id String @id @default(cuid())

  familyId String

  childUserId String
  childUser   User   @relation("ChoreChild", fields: [childUserId], references: [id], onDelete: Cascade)

  title        String
  rewardType   ChoreRewardType @default(MONEY)
  /// Set when rewardType is MONEY, null when POINTS.
  rewardCents  Int?
  /// Set when rewardType is POINTS, null when MONEY.
  rewardPoints Int?
  recurrence   ChoreRecurrence

  /// When false, completeChore applies the reward and marks APPROVED immediately — no PENDING
  /// state, no parent action needed. Parent-configurable per chore at creation.
  requiresApproval Boolean @default(true)

  /// Soft toggle, never hard-deleted — consistent with deactivatedAt elsewhere. Also set to
  /// false automatically once a ONCE chore's completion is approved (nothing left to do).
  active Boolean @default(true)

  /// True only for the daily placeholder chores meal-plan/laundry auto-generate — unlike a
  /// real chore a parent creates and might want a history of, these are pure mechanical
  /// duplicates of the calendar and get hard-deleted once resolved (see maintenanceService),
  /// same as other pure history like notification logs.
  autoGenerated Boolean @default(false)

  /// Set when a CHORE_REMINDER notification was last sent to the child for this chore's
  /// current period, so the hourly reminder check never nags twice for the same period.
  lastReminderSentAt DateTime?

  /// Set when a separate evening CHORE_REMINDER pass (distinct cadence from the hourly
  /// threshold-based one above) was last sent, so that pass never nags twice in the same
  /// evening. Independent of lastReminderSentAt so the two passes don't suppress each other.
  lastEveningReminderSentAt DateTime?

  /// Null means "active immediately", same as every chore before this field existed. Set to a
  /// future midnight-UTC date when a chore is created via "reporter à demain" — the chore is
  /// excluded from lists/reminders until that date arrives, at which point it behaves exactly
  /// like any other chore.
  startsOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions ChoreCompletion[]

  @@index([familyId])
  @@index([childUserId])
}

/// A lightweight personal to-do — created by any family member (parent or child) for
/// themselves, no reward, no approval step: just a title and a done/not-done flag, toggled by
/// the owner. Deliberately its own model rather than a Chore, since Chore.childUserId, the
/// reward fields, and the approval workflow all assume a parent rewarding a child — none of
/// that applies here.
model PersonalTask {
  id String @id @default(cuid())

  familyId String
  userId   String
  user     User   @relation("PersonalTaskOwner", fields: [userId], references: [id], onDelete: Cascade)

  title String

  /// When true, the task is a standing daily habit — `done` reflects only today (backed by
  /// `lastDoneDate`, reset automatically each new day). When false, it's a one-off task for a
  /// specific `date`, and `done` is a simple persistent flag.
  recurring Boolean @default(false)
  /// Set only when NOT recurring — the single day this task is for.
  date DateTime?
  /// Set only when recurring — the last calendar day this was marked done, so "done" can be
  /// computed as "was it marked today" without a separate completions table.
  lastDoneDate DateTime?
  /// Set only when NOT recurring.
  done Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([userId])
}

/// A child's savings goal — "what am I saving up for", shown against their current balance so
/// they can see how much is still missing. One goal per child at a time (setting a new one
/// replaces the old); the photo is stored inline as a data URL rather than in a separate file
/// store, since this app has no other file-storage integration and the image is small
/// (resized client-side before upload).
model SavingsGoal {
  id String @id @default(cuid())

  familyId String
  userId   String @unique
  user     User   @relation("SavingsGoalOwner", fields: [userId], references: [id], onDelete: Cascade)

  title       String
  targetCents Int
  photoDataUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

/// One row per time a child marks a chore done. Unlike AllowanceHistory/InterestHistory
/// (system-generated, strictly one row per period), there is no DB-level unique constraint
/// on [choreId, periodStart]: a REJECTED completion must allow the child to try again in the
/// same period, so "already pending/done for this period" is checked in application code.
model ChoreCompletion {
  id String @id @default(cuid())

  choreId String
  chore   Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)

  /// The day (DAILY), the Monday of the week (WEEKLY), or the chore's creation day (ONCE)
  /// this completion counts toward.
  periodStart DateTime
  status      ChoreCompletionStatus @default(PENDING)

  /// Copied from Chore.rewardType/rewardCents/rewardPoints at completion time, so a later
  /// reward edit never rewrites already-recorded history.
  rewardType   ChoreRewardType
  rewardCents  Int?
  rewardPoints Int?

  respondedById String?
  respondedBy   User?     @relation("ChoreCompletionResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set only once approved, linking to the transaction it produced.
  transactionId String? @unique

  /// Set once a CHORE_REMINDER notification has been sent to the parents for this pending
  /// completion, so the hourly reminder check only nags once per completion.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([choreId])
  @@index([status])
}

/// One reward tier a parent defines for a specific child's cosmetic chore-points score (e.g.
/// "100 points = choisir le dessert"). Per-child, not family-wide — each child has their own
/// ladder, since siblings rarely want the same rewards at the same point thresholds.
model PointsRewardGoal {
  id String @id @default(cuid())

  familyId       String
  childUserId    String
  title          String
  pointsRequired Int

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([childUserId])
}

/// One config row per weekday (0 = Monday .. 6 = Sunday) saying who cooks dinner that day.
/// FIXED always resolves to `fixedUserId`. ROTATING draws from the family's single shared
/// rotation order (MealPlanRotationOrder below) — every rotating weekday uses the same list
/// and sequence, just offset by its own weekday number so several rotating days in the same
/// week don't all land on the same person. Advances automatically every week — no stored
/// per-week state, no scheduled job needed to "move it along".
model MealPlanSlot {
  id String @id @default(cuid())

  familyId String
  weekday  Int

  mode MealPlanDayMode @default(FIXED)

  /// Populated when mode is FIXED, empty when ROTATING. One or more people doing it together.
  fixedUserIds String[] @default([])

  updatedAt DateTime @updatedAt

  @@unique([familyId, weekday])
  @@index([familyId])
}

/// The one shared rotation order used by every ROTATING weekday in a family — one row per
/// family. Deliberately not per-weekday: "the rotation order is always the same" regardless
/// of which day is rotating, so the parent only ever configures it once. Stored as JSON since
/// Prisma/Postgres arrays can't be nested: an ordered array of turns, each turn itself an array
/// of one or more userIds doing it together (e.g. [["u1"], ["u2","u3"], ["u1"]]).
model MealPlanRotationOrder {
  familyId      String   @id
  orderedGroups Json     @default("[]")
  updatedAt     DateTime @updatedAt
}

/// Family-wide opt-in: when `enabled`, the daily cook is also given a real Chore for the day
/// (only when they're a CHILD — chores are a kid-reward mechanism, parents never get one),
/// using this reward/approval config. One row per family, created lazily on first enable.
model MealPlanChoreConfig {
  familyId String @id

  enabled          Boolean         @default(false)
  requiresApproval Boolean         @default(true)
  rewardType       ChoreRewardType @default(POINTS)
  rewardCents      Int?
  rewardPoints     Int?

  updatedAt DateTime @updatedAt
}

/// Personal tracking for one calendar date's cooking turn — whoever's assigned can mark it done
/// for themselves, or push it to another date if they didn't have time (`postponedToDate`).
/// Purely a display overlay on top of the calendar-driven rotation: it never changes who's
/// actually up next, it only changes what today's occurrence *shows*. One row per family per
/// date since MealPlanSlot only ever has one cook per day.
model MealPlanOccurrenceStatus {
  id String @id @default(cuid())

  familyId String
  date     DateTime

  done            Boolean   @default(false)
  postponedToDate DateTime?

  updatedAt DateTime @updatedAt

  @@unique([familyId, date])
  @@index([familyId])
}

/// Dedupe log for the "it's your turn to cook" pushes — one row per family, per calendar date,
/// per kind (TODAY same-day reminder, ADVANCE the evening-before heads-up for the next day) once
/// that (date, kind) pair has been notified, so the hourly check never nags twice. Split by kind
/// because both reminders can legitimately target the same date: TODAY's advance notice sent
/// yesterday evening, and TODAY's own same-day reminder sent once that date arrives.
model MealCookNotificationLog {
  id String @id @default(cuid())

  familyId String
  date     DateTime
  kind     String   @default("TODAY")

  userId String
  user   User   @relation("MealCookNotified", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([familyId, date, kind])
  @@index([familyId])
}

/// One user-named laundry type per row (e.g. "Blancs", "Couleurs", "Draps") — families define
/// as many or as few as they like, unlike MealPlanSlot's fixed 7 weekdays. FIXED always
/// resolves to `fixedUserId`. ROTATING draws from this type's own `rotationOrder`, advanced
/// automatically by calendar week (same weekIndexFor math as meal plan) — no manual "done"
/// action, since `scheduleType`/`weekdays`/`onceDate` already say exactly when each occurrence
/// falls, the same way MealPlanSlot's weekday drives its own rotation.
model LaundryType {
  id String @id @default(cuid())

  familyId String
  name     String
  order    Int    @default(0)

  mode MealPlanDayMode @default(FIXED)

  /// Populated when mode is FIXED, empty when ROTATING. One or more people doing it together.
  fixedUserIds String[] @default([])

  /// An ordered array of turns, each turn itself an array of one or more userIds doing it
  /// together — same JSON shape as MealPlanRotationOrder.orderedGroups, but scoped to this
  /// type instead of shared family-wide.
  rotationGroups Json @default("[]")

  /// When this type is due. ONCE: a single specific calendar date (`onceDate`), never repeats.
  /// WEEKLY: one weekday (`weekdays` has exactly one entry, e.g. [2] for every Wednesday).
  /// MULTIPLE: several weekdays, all recurring every week (e.g. [0, 3] for every Monday and
  /// Thursday). Drives both the rotation math and the day-before/day-of notification job, the
  /// same way MealPlanSlot's weekday does.
  scheduleType LaundryScheduleType @default(WEEKLY)
  weekdays     Int[]               @default([])
  onceDate     DateTime?

  /// Opt-in: when true, whoever's due also gets a real Chore for the day (only when they're a
  /// CHILD — chores are a kid-reward mechanism, parents never get one).
  generatesChore        Boolean          @default(false)
  choreRequiresApproval Boolean          @default(true)
  choreRewardType       ChoreRewardType?
  choreRewardCents      Int?
  choreRewardPoints     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

/// Same overlay as MealPlanOccurrenceStatus, but per (laundryTypeId, date) since several types
/// can be due the same day.
model LaundryOccurrenceStatus {
  id String @id @default(cuid())

  familyId      String
  laundryTypeId String
  date          DateTime

  done            Boolean   @default(false)
  postponedToDate DateTime?

  updatedAt DateTime @updatedAt

  @@unique([laundryTypeId, date])
  @@index([familyId])
}

/// Dedupe log for "it's your turn to do this laundry" pushes — one row per laundry type, per
/// calendar date, per kind (TODAY / ADVANCE the evening before). Scoped per laundry type
/// (unlike MealCookNotificationLog, which is per family) since several types can legitimately
/// be due on the same date, each needing its own independent notification.
model LaundryNotificationLog {
  id String @id @default(cuid())

  familyId      String
  laundryTypeId String
  date          DateTime
  kind          String   @default("TODAY")

  userId String
  user   User   @relation("LaundryNotified", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([laundryTypeId, date, kind])
  @@index([familyId])
}

/// A parent-authored reminder — free-text title/body, sent on `date` (ONCE) or every week on
/// `date`'s weekday (`recurring`). `sendToAll` broadcasts to every family member; otherwise
/// only `recipientUserIds` (a chosen subset, meant for specific children) gets it.
model CustomNotification {
  id String @id @default(cuid())

  familyId String
  title    String
  body     String

  date      DateTime
  recurring Boolean  @default(false)
  /// HH:mm (24h), compared against the current UTC time-of-day when the notification fires —
  /// same UTC-everywhere convention as the rest of the app's date/time handling.
  time      String   @default("08:00")

  sendToAll        Boolean  @default(true)
  recipientUserIds String[] @default([])

  createdById String
  createdBy   User   @relation("CustomNotificationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  logs CustomNotificationLog[]

  createdAt DateTime @default(now())

  @@index([familyId])
}

/// Dedupe log — one row per CustomNotification per calendar date it's actually been sent for,
/// so the hourly check never repeats itself (same convention as MealCookNotificationLog).
model CustomNotificationLog {
  id String @id @default(cuid())

  customNotificationId String
  customNotification   CustomNotification @relation(fields: [customNotificationId], references: [id], onDelete: Cascade)

  date DateTime

  createdAt DateTime @default(now())

  @@unique([customNotificationId, date])
}

/// A shared family shopping list — any member can add or check off an item. familyId is a
/// loose scope field, same convention as Chore.familyId above.
model ShoppingListItem {
  id String @id @default(cuid())

  familyId String
  label    String

  isChecked Boolean @default(false)

  addedById String
  addedBy   User   @relation("ShoppingListAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  checkedById String?
  checkedBy   User?   @relation("ShoppingListCheckedBy", fields: [checkedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([familyId])
}

/// A child flagging one of their own completed transactions as erroneous. Loosely linked to
/// the Transaction by id (same pattern as Notification's relatedTransactionId) rather than a
/// hard relation, since a transaction can outlive/precede the dispute feature.
model Dispute {
  id String @id @default(cuid())

  transactionId String

  raisedById String
  raisedBy   User   @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  reason String
  status DisputeStatus @default(PENDING)

  resolvedById String?
  resolvedBy   User?     @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([raisedById])
  @@index([status])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title  String
  body   String
  isRead Boolean @default(false)

  relatedTransactionId     String?
  relatedMoneyRequestId    String?
  relatedDisputeId         String?
  relatedChoreCompletionId String?
  /// Set only for CHORE_REMINDER (fires before any completion exists, unlike the field above).
  relatedChoreId           String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

/// Per-user opt-out, one row per (user, category) they've explicitly turned off — absence of a
/// row means "on" (the default for everyone, including existing accounts with no rows yet).
model NotificationPreference {
  id     String               @id @default(cuid())
  userId String
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  enabled  Boolean              @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

/// One row per browser/device the user enabled push notifications on (endpoint is
/// unique per subscription, so the same user can have several devices).
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("PushSubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model InterestHistory {
  id            String       @id @default(cuid())
  accountId     String
  account       ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Normalized to the 1st day of the month the interest was earned for.
  month         DateTime
  rateBps       Int
  amountCents   Int
  transactionId String       @unique
  createdAt     DateTime     @default(now())

  @@unique([accountId, month])
}

/// Records each weekly allowance payment so processing is idempotent (never pay the same
/// week twice) even if the server was offline and catches up on several weeks at once.
model AllowanceHistory {
  id            String       @id @default(cuid())
  accountId     String
  account       ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Normalized to the Monday of the week this allowance was paid for.
  weekStart     DateTime
  amountCents   Int
  transactionId String       @unique
  createdAt     DateTime     @default(now())

  @@unique([accountId, weekStart])
}

/// A child's current position in one stock symbol. Quantity/average cost are kept as a
/// running aggregate rather than derived from StockOrder history each time, so reading a
/// portfolio never needs to replay every past order.
model StockHolding {
  id               String       @id @default(cuid())
  accountId        String
  account          ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol           String
  companyName      String
  quantity         Float
  /// Average cost per share, in cents — recomputed on every BUY/GIFT; unchanged on SELL.
  averageCostCents Int
  /// Set once when the position is opened (first BUY or GIFT); unchanged by later top-ups.
  /// A position that's fully sold and later reopened gets a fresh date on the new row.
  firstPurchaseAt  DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, symbol])
}

/// A child-proposed buy/sell order awaiting parental approval — mirrors MoneyRequest's
/// propose/approve/reject/cancel lifecycle, but for stock trades instead of cash moves.
model StockOrder {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("StockOrderRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  accountId String
  account   ChildAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type   StockOrderType
  status StockOrderStatus @default(PENDING)

  symbol              String
  companyName         String
  quantity            Float
  /// Price snapshot at request time, shown to the parent for context — the actual trade
  /// re-fetches a live quote at approval time rather than trusting this stale value.
  estimatedPriceCents Int
  comment             String?

  respondedById String?
  respondedBy   User?     @relation("StockOrderResponder", fields: [respondedById], references: [id], onDelete: Cascade)
  respondedAt   DateTime?

  /// Set once approved, linking to the transaction it produced.
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([accountId])
  @@index([status])
}

model Settings {
  id       String @id @default(cuid())
  familyId String @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  /// Interest rate in basis points (240 = 2.40%).
  defaultInterestRateBps Int    @default(240)
  currency               String @default("CHF")

  /// Feature toggles — off by default for a brand-new family (a parent opts in during
  /// onboarding or later from Paramètres); a family that existed before these toggles were
  /// added keeps everything on (see migration backfill), so nothing disappears under them.
  stocksEnabled       Boolean @default(false)
  mealPlanEnabled     Boolean @default(false)
  shoppingListEnabled Boolean @default(false)
  laundryEnabled      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

/// Persisted so refresh tokens can be revoked (logout, rotation, security incident)
/// instead of relying purely on stateless JWT expiry.
model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the refresh token — the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
